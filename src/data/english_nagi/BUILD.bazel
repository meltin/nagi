# The English word list generated by tools/english/prepare_english_words.sh.
# It is not committed. Without it the list is empty and the automatic input
# mode finds nothing.

genrule(
    name = "english_words",
    srcs = glob(
        ["generated/*.tsv"],
        allow_empty = True,
    ),
    outs = ["english_words.tsv"],
    cmd = "cat $(SRCS) /dev/null > $@",
    visibility = ["//english:__pkg__"],
)
