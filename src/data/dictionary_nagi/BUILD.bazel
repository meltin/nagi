# Extra system dictionaries generated by tools/dictionary/prepare_dictionary.sh.
# They are not committed. Without them this is empty and Nagi builds with the
# plain Mozc dictionary.

filegroup(
    name = "generated",
    srcs = glob(
        ["generated/*.txt"],
        allow_empty = True,
    ),
    visibility = ["//data/dictionary_oss:__pkg__"],
)
